# Copy to .env (gitignored) at the repo root. The backend loads it at startup; exported shell variables override it.
# Settings are defined in app/backend/src/api/config.py, one section per client (LLM_*, SIM_*, DB_*).

# ---- Web app backend (app/backend) ----
# Demo data for building and showing the UI: the API runs on generated demo data in DATA_DIR/demo (its own SQLite file,
# never the real database) and generates it in the background on its first start. Mock results, made-up physical trials.
# DEMO_DATA=true

# LLM step: mock (default) | anthropic | http. Unset with a key present: anthropic.
# LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# LLM_URL=http://localhost:9100/suggest

# Simulator: mock (default) | http  (http -> sim/sim_server running next to Isaac Sim; the app posts to SIM_URL/evaluate_batch)
# SIM_BACKEND=http
# SIM_URL=http://localhost:9000
# SIM_TIMEOUT_S=3600       # one request is a whole round of designs x grid points
# SIM_GRASPS_PER_S=        # throughput for run-time estimates, until runs on this backend have measured it

# Where app.db, uploads/ and outputs/ go (default: app/data)
# DATA_DIR=

# Database: unset means the SQLite file in DATA_DIR. Any SQLAlchemy URL works, e.g. Postgres:
# DB_URL=postgresql+psycopg://user:password@host:5432/fingers
# DB_ECHO=false            # true logs every SQL statement
# DB_AUTO_MIGRATE=true     # false where deploys run `alembic upgrade head` themselves

# DEBUG | INFO (default) | WARNING | ERROR
# LOG_LEVEL=INFO

# ---- Digital twin (sim/fanuc_er4ia_sim, on the GPU machine) ----
# ISAAC=/path/to/isaacsim
# COSMOS=/path/to/cosmos-env/bin/python
# COSMOS3_NANO_PATH=/path/to/Cosmos3-Nano/snapshot
# COSMOS3_ROOT=/path/to/cosmos-framework
# FANUC_ROBOT_USD=/path/to/er4ia.usd
# HOST_PYTHON=
