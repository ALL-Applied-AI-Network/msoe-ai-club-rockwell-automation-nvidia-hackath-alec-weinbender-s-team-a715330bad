# Copy to .env (gitignored) at the repo root. The backend loads it at startup; exported shell variables override it.
# Settings are defined in app/backend/src/api/config.py, one section per client (LLM_*, SIM_*, DB_*).

# ---- Web app backend (app/backend) ----
# Demo data for building and showing the UI: the API runs on generated demo data in DATA_DIR/demo (its own SQLite file,
# never the real database) and generates it in the background on its first start. Mock results, made-up physical trials.
# DEMO_DATA=true

# LLM step: mock (default) | anthropic | http. Unset with a key present: anthropic.
# LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# LLM_URL=http://localhost:9100/suggest

# Simulator: mock (default) | http  (http -> sim/sim_server running next to Isaac Sim; the app posts to SIM_URL/evaluate_batch)
# SIM_BACKEND=http
# SIM_URL=http://localhost:9000
# SIM_TIMEOUT_S=3600       # one request is a whole round of designs x grid points
# SIM_RECONNECT_MINUTES=120  # a round whose connection drops (the VPN, the port forward) waits this long for it; 0: fail at once
# SIM_GRASPS_PER_S=        # throughput for run-time estimates, until runs on this backend have measured it

# GPU targets for the sim (the GPU panel): where the real sim server runs, never what the rest of the app sees. The
# connected target is forwarded to SIM_URL's port here, so jobs only ever talk to SIM_URL, whichever target it is.
# Comma-separated: mock (default: made-up targets) | brev | gb10. One target is connected at a time.
# Real targets need SIM_BACKEND=http and SIM_URL=http://127.0.0.1:9000, and the target set up once by hand
# (docs/notes/gpu-test-plan.md).
# COMPUTE_BACKENDS=brev,gb10
# COMPUTE_START_TIMEOUT_S=1200          # boot, the container and Isaac Sim, together
#
# Brev: the panel lists the team's instances (created in the Brev console), starts the one you choose and the sim server
# on it, and stops it when asked or after COMPUTE_AUTO_STOP_MINUTES without a job.
# COMPUTE_BREV_WSL=Ubuntu               # Windows: the WSL distro the Brev CLI is installed in (it only runs there)
# COMPUTE_BREV_CLI=brev                 # the CLI's command or path (inside WSL when COMPUTE_BREV_WSL is set)
# COMPUTE_BREV_TOKEN=                   # optional: logs the CLI in at startup; unset uses your own `brev login`
# COMPUTE_AUTO_STOP_MINUTES=20          # 0 turns auto-stop off
# COMPUTE_SIM_ARGS=                     # extra sim_server flags, e.g. --envs 64
# COMPUTE_SIM_PORT=9000                 # where the sim server listens on the instance
# COMPUTE_SIM_CONTAINER=vscode          # the Isaac launchable's container; empty runs it on the machine itself
# COMPUTE_SIM_DIR=/root/repo            # the repo on the instance
# COMPUTE_ISAAC_PYTHON=/isaac-sim/python.sh
#
# MSOE GB10: always on and shared with other teams, so the panel connects to it (starting the sim server there if it
# isn't running) and disconnecting leaves the server running. Over ssh with your key (no password setting, by team
# rule), on the MSOE VPN.
# COMPUTE_SSH=ssh                       # the ssh command (Windows: the built-in OpenSSH)
# COMPUTE_GB10_HOST=spark1.ai.msoe.edu
# COMPUTE_GB10_USER=hackathon11
# COMPUTE_GB10_SIM_PORT=9011            # not 9000: other accounts can reach the GB10's localhost ports
# COMPUTE_GB10_SIM_DIR=/home/hackathon11/repo
# COMPUTE_GB10_ISAAC_PYTHON=/home/hackathon11/isaac-sim-6.0.1/python.sh
# COMPUTE_GB10_SIM_ARGS=                # extra sim_server flags

# Where app.db, uploads/ and outputs/ go (default: app/data)
# DATA_DIR=

# Database: unset means the SQLite file in DATA_DIR. Any SQLAlchemy URL works, e.g. Postgres:
# DB_URL=postgresql+psycopg://user:password@host:5432/fingers
# DB_ECHO=false            # true logs every SQL statement
# DB_AUTO_MIGRATE=true     # false where deploys run `alembic upgrade head` themselves

# DEBUG | INFO (default) | WARNING | ERROR
# LOG_LEVEL=INFO

# ---- Digital twin (sim/fanuc_er4ia_sim, on the GPU machine) ----
# ISAAC=/path/to/isaacsim
# COSMOS=/path/to/cosmos-env/bin/python
# COSMOS3_NANO_PATH=/path/to/Cosmos3-Nano/snapshot
# COSMOS3_ROOT=/path/to/cosmos-framework
# FANUC_ROBOT_USD=/path/to/er4ia.usd
# HOST_PYTHON=
